{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eb-local modulerc --json",
  "description": "Invalid UTF-8 bytes in module_tree, file, directives, or content are replaced with U+FFFD, so non-UTF-8 strings do not round-trip.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "module_tree",
    "file",
    "mode",
    "changed",
    "defaults",
    "aliases",
    "hidden",
    "content"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "modulerc" },
    "module_tree": { "type": "string" },
    "file": { "type": "string" },
    "mode": { "enum": ["write", "dry-run", "check"] },
    "changed": { "type": "boolean" },
    "defaults": { "type": "array", "items": { "type": "string" } },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "target"],
        "properties": {
          "name": { "type": "string" },
          "target": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "hidden": { "type": "array", "items": { "type": "string" } },
    "content": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
