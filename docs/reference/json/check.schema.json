{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eb-local check --json",
  "type": "object",
  "required": ["schema_version", "kind", "problem_count", "unreadable", "elf_count", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "check" },
    "problem_count": { "type": "integer", "minimum": 0 },
    "unreadable": { "type": "boolean" },
    "elf_count": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "machine", "problems"],
        "properties": {
          "path": { "type": "string" },
          "machine": { "type": "string" },
          "problems": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
