#!/bin/sh
# eb-local POSIX delegation shim

case $0 in
    */*) shim=$0 ;;
    *) shim=$(command -v "$0" 2>/dev/null) ;;
esac

if [ -x /usr/bin/readlink ]; then
    readlink_cmd=/usr/bin/readlink
elif [ -x /bin/readlink ]; then
    readlink_cmd=/bin/readlink
else
    readlink_cmd=$(command -v readlink 2>/dev/null)
fi
real_shim=$("$readlink_cmd" -f -- "$shim" 2>/dev/null) || {
    printf '%s\n' "eb-local: cannot resolve the real path of the shell shim $shim" >&2
    exit 127
}
real_dir=${real_shim%/*}
zig_bin=$real_dir/zig-out/bin/eb-local

if [ -x "$zig_bin" ] && [ ! -d "$zig_bin" ]; then
    exec "$zig_bin" "$@"
fi

is_delegation_shim()
{
    marker_lines=0
    while IFS= read -r marker_line; do
        [ "$marker_line" = "# eb-local POSIX delegation shim" ] && return 0
        marker_lines=$((marker_lines + 1))
        [ "$marker_lines" -lt 4 ] || break
    done < "$1"
    return 1
}

searched=
path_left=${PATH-}
while :; do
    case $path_left in
        *:*) dir=${path_left%%:*}; path_left=${path_left#*:}; last=false ;;
        *) dir=$path_left; path_left=; last=true ;;
    esac
    [ -n "$dir" ] || dir=.
    if absolute_dir=$(unset CDPATH; cd -P -- "$dir" 2>/dev/null && pwd); then
        :
    else
        case $dir in
            /*) absolute_dir=$dir ;;
            *) absolute_dir=$PWD/$dir ;;
        esac
    fi
    searched="${searched}
  PATH directory: $absolute_dir"
    candidate=$absolute_dir/eb-local
    if [ -x "$candidate" ] && [ ! -d "$candidate" ] &&
        ! is_delegation_shim "$candidate"; then
        exec "$candidate" "$@"
    fi
    [ "$last" = false ] || break
done

printf '%s\n' \
    "eb-local: Zig binary not found" \
    "  real script directory: $real_dir" \
    "  Zig build: $zig_bin${searched}" >&2
exit 127
