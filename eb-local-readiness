#!/usr/bin/env python3
"""Check the EESSI client mount and local-module precedence without changing them."""

import argparse
import os
from pathlib import Path
import re
import sys


def unescape_mount(value):
    """Decode the octal escapes used by Linux mountinfo."""
    return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), value)


def under(path, root):
    """Whether PATH is ROOT or below it, without requiring either to exist."""
    path = os.path.realpath(path)
    root = os.path.realpath(root)
    try:
        return os.path.commonpath((path, root)) == root
    except ValueError:
        return False


def mount_for(path, mountinfo):
    """Return the deepest (mount point, filesystem type) containing PATH."""
    best = None
    for line in mountinfo.splitlines():
        head, separator, tail = line.partition(" - ")
        if not separator:
            continue
        fields = head.split()
        after = tail.split()
        if len(fields) < 6 or not after:
            continue
        target = unescape_mount(fields[4])
        real_target = os.path.realpath(target)
        if under(path, target) and (best is None or len(real_target) >= len(best[0])):
            best = (real_target, after[0])
    return best


def default_prefix():
    """Return the local installation prefix already selected by this shell."""
    for name in (
        "EB_LOCAL_PREFIX",
        "EESSI_SITE_SOFTWARE_PREFIX",
        "EESSI_PROJECT_INSTALL",
        "EESSI_USER_INSTALL",
    ):
        value = os.environ.get(name)
        if value:
            return value
    return None


def check(repo, prefix, modulepath, mountinfo):
    """Print readiness findings and return whether a finding says FAIL."""
    failed = False
    if not os.path.isdir(repo):
        print("FAIL EESSI repository {} is not a directory".format(repo))
        failed = True
    else:
        mount = mount_for(repo, mountinfo)
        if mount is None:
            print("warn EESSI repository {} has no mount-table entry".format(repo))
        elif mount[1] == "cvmfs":
            print("ok   EESSI repository {} is mounted with cvmfs".format(repo))
        else:
            print(
                "warn EESSI repository {} is on {}, not cvmfs; "
                "check the EESSI client or site bind mount".format(repo, mount[1])
            )

    paths = [path for path in modulepath.split(":") if path]
    upstream = next((index for index, path in enumerate(paths) if under(path, repo)), None)
    if prefix is None:
        print("info no local prefix is selected; pass --prefix or set EB_LOCAL_PREFIX")
    else:
        local = next((index for index, path in enumerate(paths) if under(path, prefix)), None)
        if local is None:
            print("FAIL no module directory under {} is on MODULEPATH".format(prefix))
            failed = True
        elif upstream is None:
            print("warn no module directory under {} is on MODULEPATH".format(repo))
        elif local < upstream:
            print("ok   local modules precede EESSI on MODULEPATH")
        else:
            print(
                "FAIL EESSI precedes local modules on MODULEPATH; "
                "an upstream module can hide the local install"
            )
            failed = True
    return failed


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Check the EESSI mount and local-module precedence"
    )
    parser.add_argument(
        "--repo",
        default=os.environ.get("EESSI_CVMFS_REPO") or "/cvmfs/software.eessi.io",
        help="EESSI repository (default: EESSI_CVMFS_REPO or /cvmfs/software.eessi.io)",
    )
    parser.add_argument(
        "--prefix",
        default=default_prefix(),
        help="local installation prefix (default: the prefix selected by the environment)",
    )
    parser.add_argument(
        "--mountinfo",
        default="/proc/self/mountinfo",
        help="mount table to read (default: /proc/self/mountinfo)",
    )
    args = parser.parse_args(argv)
    if args.repo == "":
        print("FAIL --repo must not be empty", file=sys.stderr)
        return 2
    if args.prefix == "":
        print("FAIL --prefix must not be empty", file=sys.stderr)
        return 2
    try:
        mountinfo = Path(args.mountinfo).read_text(encoding="utf-8")
    except OSError as error:
        print("FAIL cannot read {}: {}".format(args.mountinfo, error), file=sys.stderr)
        return 1
    return int(check(args.repo, args.prefix, os.environ.get("MODULEPATH", ""), mountinfo))


if __name__ == "__main__":
    sys.exit(main())
